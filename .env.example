# Hostinger MySQL — mysql://user:password@host:3306/dbname
DATABASE_URL=

# Meta System User token with ads_read. Never expires; treat it like a password.
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v21.0

# Dashboard login. One shared password; change it by editing this and redeploying.
DASHBOARD_PASSWORD=
# openssl rand -hex 32
SESSION_SECRET=

# Shared secret the nightly cron sends as `Authorization: Bearer <value>`.
CRON_SECRET=

# ── Google Ads ────────────────────────────────────────────────────
# The service-account JSON key, pasted as ONE line. No developer token:
# they were sunset 2026-09-09 and are ignored by the API.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Manager (MCC) customer id, digits only, no hyphens. Omit if the service
# account is added directly to each ad account.
GOOGLE_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v25
